---
import ProjectCard from '../components/ProjectCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StagesCarousel from '../components/StagesCarousel.astro';
import SeoHead from '../components/SeoHead.astro';
import { getHomeHeroVideos } from '../lib/home-hero';
import { getContactDescriptionLines, getLocale, getMessages, localizePath } from '../lib/i18n';
import { getPublishedProjects, localizeProject } from '../lib/projects';
import { absoluteLocalizedUrl, absoluteSiteUrl } from '../lib/seo';
import { defaultSiteSettings, getSiteSettings, resolvePrivacyPdfUrl } from '../lib/site-settings';
import { brandCopy, brandThemeStyle } from '../lib/site-settings-shared';

const locale = getLocale(Astro.originPathname);
const m = getMessages(locale);
// Keep the form DOM stable for the shared consultation script.
const [sourceProjects, homeHeroVideos, siteSettings] = await Promise.all([
  getPublishedProjects(),
  getHomeHeroVideos(),
  getSiteSettings(),
]);
const projects = sourceProjects.map((project) => localizeProject(project, locale));
const homeCopy = siteSettings.homeCopy[locale];
const contactCopy = siteSettings.contactCopy[locale];
const aboutBenefits = [
  { className: 'about-card-direct', icon: 'img/about_carousel/Group 2136141923.svg', title: homeCopy.benefitDirectTitle, text: homeCopy.benefitDirectText },
  { className: 'about-card-legal', icon: 'img/about_carousel/Group 2136141905.svg', title: homeCopy.benefitLegalTitle, text: homeCopy.benefitLegalText },
  { className: 'about-card-personal', icon: 'img/about_carousel/Group 2136141924.svg', title: homeCopy.benefitPersonalTitle, text: homeCopy.benefitPersonalText },
  { className: 'about-card-locations', icon: 'img/about_carousel/Group 2136141925.svg', title: homeCopy.benefitLocationTitle, text: homeCopy.benefitLocationText },
];
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
const serializedHomeHeroVideos = JSON.stringify(homeHeroVideos.map((video) => ({
  id: video.id,
  title: video.title,
  desktopUrl: video.desktopUrl,
  mobileUrl: video.mobileUrl,
})));
const homeUrl = absoluteLocalizedUrl('/', locale, Astro.url);
const projectsHref = localizePath('/#projects', locale);
const goldenVisaHref = localizePath('/golden-visa', locale);
const privacyPolicyHref = resolvePrivacyPdfUrl(siteSettings, locale);
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      url: homeUrl,
      name: siteSettings.siteName,
      inLanguage: locale,
    },
    {
      '@type': 'Organization',
      '@id': `${homeUrl}#organization`,
      name: siteSettings.companyName,
      ...(siteSettings.logoUrl || siteSettings.siteName === 'MIRACON' ? { logo: {
        '@type': 'ImageObject',
        url: absoluteSiteUrl(siteSettings.logoUrl || '/favicon.svg', Astro.url),
        ...(siteSettings.logoUrl ? {} : { width: 512, height: 512 }),
      } } : {}),
      image: absoluteSiteUrl('/img/figma_hero.png', Astro.url),
      telephone: siteSettings.footerPhone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteSettings.footerAddress[locale],
        addressCountry: 'GR',
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang={locale} style={brandThemeStyle(siteSettings)}>

<head>
  <meta charset="UTF-8">
  <base href="/">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SeoHead
    title={brandCopy(m['home.seoTitle'], siteSettings)}
    description={brandCopy(m['home.seoDescription'], siteSettings)}
    path="/"
    image="/img/figma_hero.png"
    imageAlt={brandCopy(m['home.seoImageAlt'], siteSettings)}
    jsonLd={homeStructuredData}
    siteName={siteSettings.siteName}
    logoUrl={siteSettings.logoUrl}
    brandColor={siteSettings.brandColor}
    locale={locale}
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <link rel="stylesheet" href="/shared-mobile-components.css">
</head>

<body>
  <SiteHeader locale={locale} settings={siteSettings} />

  <main>
    <section class="hero-pin" aria-label={brandCopy(m['home.heroLabel'], siteSettings)}>
      <div class="hero">
        <div class="hero-media" data-home-hero-playlist={serializedHomeHeroVideos}>
          <video class="hero-video is-active" muted loop={homeHeroVideos.length === 1} playsinline preload="none" poster="/img/figma_hero.png"></video>
          <video class="hero-video" muted playsinline preload="none" poster="/img/figma_hero.png" aria-hidden="true"></video>
        </div>
        <div class="container hero-content notranslate" translate="no">
          <p class="hero-subtitle">{homeCopy.heroLocation}</p>
          <h1 class="hero-title">{homeCopy.heroTitleLine1}<br>{homeCopy.heroTitleLine2}</h1>
          <div class="hero-actions">
            <a href={projectsHref} class="btn-hero">
              <span class="btn-arrow btn-arrow-left"></span>
              <span>{m['home.exploreProjects']}</span>
            </a>
            <a href={goldenVisaHref} class="badge-visa glass-gradient">{m['home.goldenVisaBadge']}</a>
          </div>
        </div>
        <a href={projectsHref} class="hero-scroll-indicator" aria-label={m['home.scrollProjects']}>
          <img src="img/arrow_white.svg" alt="" aria-hidden="true">
        </a>
      </div>
    </section>

    <section id="projects" class="projects-section">
      <div class="container">
        <h2 class="section-title">{homeCopy.projectsTitle}</h2>
        <p class="section-subtitle">{homeCopy.projectsDescription}</p>

        <div class="filter-tabs notranslate" translate="no" aria-label={m['home.projectFilters']}>
          <button class="filter-tab active" type="button" data-filter="all" aria-pressed="true" aria-controls="projectsList"><span>{m['common.categoryAll']}</span></button>
          <button class="filter-tab" type="button" data-filter="coastal" aria-pressed="false" aria-controls="projectsList"><span>{m['common.categoryCoastal']}</span></button>
          <button class="filter-tab" type="button" data-filter="city" aria-pressed="false" aria-controls="projectsList"><span>{m['common.categoryCity']}</span></button>
          <button class="filter-tab" type="button" data-filter="golden-visa" aria-pressed="false" aria-controls="projectsList"><span>{m['common.categoryGoldenVisa']}</span></button>
        </div>

        <div class="projects-list" id="projectsList">
          {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
        </div>
      </div>
    </section>

    <section id="about" class="about-section">
      <div class="container about-container">
        <div class="about-copy">
          <h2 class="about-heading about-reveal" aria-label={`${m['home.about']} ${siteSettings.siteName}`}>
            <span class="about-title-word" aria-hidden="true">{m['home.about']}</span>
            <span class="about-brand" aria-hidden="true">
              {siteSettings.logoUrl ? <img src={siteSettings.logoUrl} alt="" class="about-brand-custom-logo">
                : siteSettings.siteName === 'MIRACON' ? <>
                <span class="about-brand-letter about-brand-letter-m"></span>
                <span class="about-brand-letter about-brand-letter-i"></span>
                <span class="about-brand-letter about-brand-letter-r"></span>
                <span class="about-brand-letter about-brand-letter-a"></span>
                <span class="about-brand-letter about-brand-letter-c"></span>
                <span class="about-brand-letter about-brand-letter-o"></span>
                <span class="about-brand-letter about-brand-letter-n"></span>
              </> : <span class="site-name-wordmark">{siteSettings.siteName}</span>}
            </span>
          </h2>
          <p class="section-subtitle about-reveal">{homeCopy.aboutTagline}</p>
          <div class="about-text about-reveal">
            <p>{brandCopy(homeCopy.aboutParagraph1, siteSettings)}</p>
            <p>{homeCopy.aboutParagraph2}</p>
          </div>
        </div>
        <OptimizedImage src="/img/about_bg.png" alt={m['home.aboutImageAlt']} class="about-image about-reveal" loading="lazy" decoding="async" />
      </div>

      <div class="about-carousel" aria-label={brandCopy(m['home.benefitsLabel'], siteSettings)}>
        <div class="about-carousel-track">
          {[false, true].map((duplicate) => (
            <div class="about-carousel-set" aria-hidden={duplicate ? 'true' : undefined}>
              {aboutBenefits.map((benefit) => (
                <article class={`about-card ${benefit.className}`}>
                  <img src={benefit.icon} alt="" class="about-card-icon">
                  <h3>{benefit.title}</h3>
                  <p>{benefit.text}</p>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="golden-visa" class="golden-visa-section">
      <div class="container golden-container">
        <div class="golden-image-wrap">
          <div class="golden-carousel-3d">
            <div class="golden-carousel-inner">
              <div class="golden-carousel-face">
                <picture>
                  <source media="(max-width: 600px)" srcset="/img/figma-mobile/golden-visa.avif" type="image/avif">
                  <source media="(max-width: 600px)" srcset="/img/figma-mobile/golden-visa.png">
                  <source srcset="/img/figma_golden_visa.avif" type="image/avif">
                  <img src="/img/figma_golden_visa.png" alt={homeCopy.visaResidencyTitle} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_2.avif" type="image/avif">
                  <img src="/img/golden_visa_2.png" alt={homeCopy.visaThresholdTitle} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_3.avif" type="image/avif">
                  <img src="/img/golden_visa_3.png" alt={homeCopy.visaFamilyTitle} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_4.avif" type="image/avif">
                  <img src="/img/golden_visa_4.png" alt={homeCopy.visaSchengenTitle} loading="lazy" decoding="async">
                </picture>
              </div>
            </div>
          </div>
          <a href={goldenVisaHref} class="visa-consult-badge glass-gradient">
            <span>{m['home.moreDetails']}</span>
            <span class="visa-consult-arrow"></span>
          </a>
        </div>

        <div class="golden-content">
          <h2 class="section-title">{m['common.goldenVisa']}</h2>
          <p class="section-subtitle">{homeCopy.visaDescription}</p>

          <div class="slider-wrapper" aria-label={m['home.visaBenefits']}>
            <div class="slider-slides">
              <article class="slide active">
                <h3 class="slide-title">
                  <img src="img/golden_visa/Subtract_1.svg" alt="" class="slide-icon">
                  {homeCopy.visaResidencyTitle}
                </h3>
                <p class="slide-text">{homeCopy.visaResidencyText}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/trending-up_2.svg" alt="" class="slide-icon">
                  {homeCopy.visaThresholdTitle}
                </h3>
                <p class="slide-text">{brandCopy(homeCopy.visaThresholdText, siteSettings)}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/Vector_3.svg" alt="" class="slide-icon">
                  {homeCopy.visaFamilyTitle}
                </h3>
                <p class="slide-text">{homeCopy.visaFamilyText}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/keypad_4.svg" alt="" class="slide-icon">
                  {homeCopy.visaSchengenTitle}
                </h3>
                <p class="slide-text slide-text-short">{homeCopy.visaSchengenText}</p>
              </article>
            </div>

            <div class="slider-controls">
              <button class="slider-btn btn-prev" aria-label={m['home.visaPrevious']}></button>
              <span class="slider-counter">1/4</span>
              <button class="slider-btn btn-next" aria-label={m['home.visaNext']}></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <StagesCarousel settings={siteSettings} locale={locale} />

    <section id="contacts" class="contacts-section">
      <div class="container">
        <div class="form-container">
          <h2 class="section-title">{contactCopy.title}</h2>
          <p class="section-subtitle form-description-copy">
            {contactCopy.description === defaultSiteSettings.contactCopy[locale].description
              ? getContactDescriptionLines(locale).map((line) => <span>{line}</span>)
              : <span>{contactCopy.description}</span>}
          </p>

          <form class="consultation-form" data-consultation-form novalidate>
            <div class="form-row">
              <label class="form-group">
                <span>{m['form.name']} *</span>
                <input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required>
              </label>
              <label class="form-group">
                <span>{m['form.phone']} *</span>
                <input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40" required>
              </label>
              <label class="form-group">
                <span>{m['form.email']} *</span>
                <input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254" required>
              </label>
            </div>

            <label class="form-group form-message">
              <span>{m['form.message']} *</span>
              <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000" required></textarea>
            </label>

            <label class="form-consent">
              <input type="checkbox" name="consent" class="form-consent-input" required disabled={!privacyPolicyHref}>
              <span class="form-consent-box" aria-hidden="true"></span>
              <span class="form-consent-text">{privacyPolicyHref
                ? <>{m['form.consentBefore']} <a href={privacyPolicyHref} target="_blank" rel="noopener noreferrer">{m['common.privacy']}</a> {m['form.consentAfter']}</>
                : m['form.policyUnavailable']}</span>
            </label>

            <button type="submit" class="btn-submit" disabled>
              <span>{m['form.submit']}</span>
              <span class="btn-submit-arrow"></span>
            </button>
            <input class="form-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
            <p class="form-status" aria-live="polite" hidden></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} settings={siteSettings} />

  <script is:inline src="/site.js"></script>
</body>
</html>
