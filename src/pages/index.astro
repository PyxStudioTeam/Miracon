---
import ProjectCard from '../components/ProjectCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SeoHead from '../components/SeoHead.astro';
import { getHomeHeroVideos } from '../lib/home-hero';
import { getContactDescriptionLines, getLocale, getMessages, localizePath, oppositeLocale } from '../lib/i18n';
import { getPublishedProjects, localizeProject } from '../lib/projects';
import { absoluteLocalizedUrl, absoluteSiteUrl } from '../lib/seo';
import { getSiteSettings } from '../lib/site-settings';

const locale = getLocale(Astro.originPathname);
const m = getMessages(locale);
const contactDescriptionLines = getContactDescriptionLines(locale);
const [sourceProjects, homeHeroVideos, siteSettings] = await Promise.all([
  getPublishedProjects(),
  getHomeHeroVideos(),
  getSiteSettings(),
]);
const projects = sourceProjects.map((project) => localizeProject(project, locale));
const firstHomeHeroVideo = homeHeroVideos[0];
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
const serializedHomeHeroVideos = JSON.stringify(homeHeroVideos.map((video) => ({
  id: video.id,
  title: video.title,
  desktopUrl: video.desktopUrl,
  mobileUrl: video.mobileUrl,
})));
const homeUrl = absoluteLocalizedUrl('/', locale, Astro.url);
const homeHref = localizePath('/', locale);
const projectsHref = localizePath('/#projects', locale);
const aboutHref = localizePath('/#about', locale);
const contactsHref = localizePath('/#contacts', locale);
const goldenVisaHref = localizePath('/golden-visa', locale);
const languageHref = localizePath(`${Astro.originPathname}${Astro.url.search}`, oppositeLocale(locale));
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      url: homeUrl,
      name: 'MIRACON',
      inLanguage: locale,
    },
    {
      '@type': 'Organization',
      '@id': `${homeUrl}#organization`,
      name: 'MIRACON',
      url: homeUrl,
      logo: {
        '@type': 'ImageObject',
        url: absoluteSiteUrl('/favicon.svg', Astro.url),
        width: 512,
        height: 512,
      },
      image: absoluteSiteUrl('/img/figma_hero.png', Astro.url),
      telephone: '+306955340416',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Egnatia 84',
        postalCode: '54623',
        addressLocality: 'Thessaloniki',
        addressCountry: 'GR',
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang={locale}>

<head>
  <meta charset="UTF-8">
  <base href="/">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <SeoHead
    title={m['home.seoTitle']}
    description={m['home.seoDescription']}
    path="/"
    image="/img/figma_hero.png"
    imageAlt={m['home.seoImageAlt']}
    jsonLd={homeStructuredData}
    locale={locale}
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <link rel="stylesheet" href="/shared-mobile-components.css">
</head>

<body>
  <header class="header">
    <div class="header-container">
      <a href={homeHref} class="logo" aria-label={m['common.logoHome']}>
        <img src="img/logo_mark.svg" alt="" class="logo-img">
        <div class="logo-letters" aria-hidden="true">
          <img src="img/logo_letters/M.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/I.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/R.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/A.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/C.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/O.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/N.svg" alt="" class="logo-letter">
        </div>
      </a>

      <nav class="nav-menu glass-gradient" aria-label={m['common.mainNavigation']}>
        <a href={projectsHref} class="nav-link">{m['common.projects']}</a>
        <a href={goldenVisaHref} class="nav-link">{m['common.goldenVisa']}</a>
        <a href={aboutHref} class="nav-link">{m['common.aboutUs']}</a>
        <a href={contactsHref} class="nav-link">{m['common.contacts']}</a>
      </nav>

      <div class="header-actions">
        <a class="lang-selector glass-gradient" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
          <span class="lang-current">{m['common.languageCode']}</span>
        </a>
        <div class="contact-menu">
          <a href={contactsHref} class="contact-btn" aria-haspopup="true">
            <span class="contact-btn-icon"></span>
            <span>{m['common.contact']}</span>
            <span class="contact-btn-arrow" aria-hidden="true">
              <img src="img/contact_header/Vector 12.svg" alt="">
            </span>
          </a>
          <div class="contact-dropdown" aria-label={m['common.quickContacts']}>
            <a href="tel:+306955340416" class="contact-dropdown-link contact-dropdown-link--phone"
              aria-label={m['common.callPhone']}>
              <span class="contact-dropdown-text">+306955340416</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Vector (1).svg" alt="">
              </span>
            </a>
            <a href="mailto:info@miracon.gr" class="contact-dropdown-link contact-dropdown-link--mail"
              aria-label={m['common.email']}>
              <span class="contact-dropdown-text">info@miracon.gr</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Group 37313 (1).svg" alt="">
              </span>
            </a>
            <a href="https://www.google.com/maps/search/?api=1&query=Egnatia+84%2C+54623+Thessaloniki%2C+Greece"
              class="contact-dropdown-link contact-dropdown-link--geo" target="_blank" rel="noreferrer"
              aria-label={m['common.openAddress']}>
              <span class="contact-dropdown-text">{m['common.address']}</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Vector (2).svg" alt="">
              </span>
            </a>
          </div>
        </div>
      </div>

      <a class="mobile-lang-selector" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
        <span>{m['common.languageCode']}</span>
      </a>
      <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label={m['common.openMenu']} aria-controls="mobileNav" aria-expanded="false">
        <span aria-hidden="true"></span>
      </button>
      <nav class="mobile-nav" id="mobileNav" aria-label={m['common.mobileNavigation']}>
        <a href={projectsHref} class="mobile-nav-link">{m['common.projects']}</a>
        <a href={goldenVisaHref} class="mobile-nav-link">{m['common.goldenVisa']}</a>
        <a href={aboutHref} class="mobile-nav-link">{m['common.aboutUs']}</a>
        <button class="mobile-nav-contact" type="button" aria-expanded="false" aria-controls="mobileContactDetails">
          <span>{m['common.contacts']}</span><span aria-hidden="true">+</span>
        </button>
        <div class="mobile-nav-contacts" id="mobileContactDetails">
          <a href="tel:+306955340416">+30 695 534 0416</a>
          <a href="mailto:info@miracon.gr">info@miracon.gr</a>
          <a href="https://www.google.com/maps/search/?api=1&query=Egnatia+84%2C+54623+Thessaloniki%2C+Greece" target="_blank" rel="noreferrer">{m['common.addressShort']}</a>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero-pin" aria-label={m['home.heroLabel']}>
      <div class="hero">
        <div class="hero-media" data-home-hero-playlist={serializedHomeHeroVideos}>
          <video class="hero-video is-active" autoplay muted loop={homeHeroVideos.length === 1} playsinline preload="auto" poster="/img/figma_hero.png">
            <source media="(max-width: 600px)" src={firstHomeHeroVideo.mobileUrl ?? firstHomeHeroVideo.desktopUrl} type="video/mp4">
            <source src={firstHomeHeroVideo.desktopUrl} type="video/mp4">
          </video>
          <video class="hero-video" muted playsinline preload="none" poster="/img/figma_hero.png" aria-hidden="true"></video>
        </div>
        <div class="container hero-content">
          <p class="hero-subtitle">{m['home.heroLocation']}</p>
          <h1 class="hero-title">{m['home.heroTitleLine1']}<br>{m['home.heroTitleLine2']}</h1>
          <div class="hero-actions">
            <a href={projectsHref} class="btn-hero">
              <span class="btn-arrow btn-arrow-left"></span>
              <span>{m['home.exploreProjects']}</span>
            </a>
            <a href={goldenVisaHref} class="badge-visa glass-gradient">{m['home.goldenVisaBadge']}</a>
          </div>
        </div>
        <a href={projectsHref} class="hero-scroll-indicator" aria-label={m['home.scrollProjects']}>
          <img src="img/arrow_white.svg" alt="" aria-hidden="true">
        </a>
      </div>
    </section>

    <section id="projects" class="projects-section">
      <div class="container">
        <h2 class="section-title">{m['home.projectsTitle']}</h2>
        <p class="section-subtitle">{m['home.projectsDescription']}</p>

        <div class="filter-tabs" aria-label={m['home.projectFilters']}>
          <button class="filter-tab active" type="button" data-filter="all" aria-pressed="true" aria-controls="projectsList"><span data-label={m['common.categoryAll']}>{m['common.categoryAll']}</span></button>
          <button class="filter-tab" type="button" data-filter="coastal" aria-pressed="false" aria-controls="projectsList"><span data-label={m['common.categoryCoastal']}>{m['common.categoryCoastal']}</span></button>
          <button class="filter-tab" type="button" data-filter="city" aria-pressed="false" aria-controls="projectsList"><span data-label={m['common.categoryCity']}>{m['common.categoryCity']}</span></button>
          <button class="filter-tab" type="button" data-filter="golden-visa" aria-pressed="false" aria-controls="projectsList"><span data-label={m['common.categoryGoldenVisa']}>{m['common.categoryGoldenVisa']}</span></button>
        </div>

        <div class="projects-list" id="projectsList">
          {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
        </div>
      </div>
    </section>

    <section id="about" class="about-section">
      <div class="container about-container">
        <div class="about-copy">
          <h2 class="about-heading about-reveal" aria-label={m['home.aboutLabel']}>
            <span class="about-title-word" aria-hidden="true">{m['home.about']}</span>
            <span class="about-brand" aria-hidden="true">
              <span class="about-brand-letter about-brand-letter-m"></span>
              <span class="about-brand-letter about-brand-letter-i"></span>
              <span class="about-brand-letter about-brand-letter-r"></span>
              <span class="about-brand-letter about-brand-letter-a"></span>
              <span class="about-brand-letter about-brand-letter-c"></span>
              <span class="about-brand-letter about-brand-letter-o"></span>
              <span class="about-brand-letter about-brand-letter-n"></span>
            </span>
          </h2>
          <p class="section-subtitle about-reveal">{m['home.aboutTagline']}</p>
          <div class="about-text about-reveal">
            <p>{m['home.aboutParagraph1']}</p>
            <p>{m['home.aboutParagraph2']}</p>
          </div>
        </div>
        <OptimizedImage src="/img/about_bg.png" alt={m['home.aboutImageAlt']} class="about-image about-reveal" loading="lazy" decoding="async" />
      </div>

      <div class="about-carousel" aria-label={m['home.benefitsLabel']}>
        <div class="about-carousel-track">
          <div class="about-carousel-set">
            <article class="about-card about-card-direct">
              <img src="img/about_carousel/Group 2136141923.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitDirectTitle']}</h3>
              <p>{m['home.benefitDirectText']}</p>
            </article>
            <article class="about-card about-card-legal">
              <img src="img/about_carousel/Group 2136141905.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitLegalTitle']}</h3>
              <p>{m['home.benefitLegalText']}</p>
            </article>
            <article class="about-card about-card-personal">
              <img src="img/about_carousel/Group 2136141924.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitPersonalTitle']}</h3>
              <p>{m['home.benefitPersonalText']}</p>
            </article>
            <article class="about-card about-card-locations">
              <img src="img/about_carousel/Group 2136141925.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitLocationTitle']}</h3>
              <p>{m['home.benefitLocationText']}</p>
            </article>
          </div>

          <div class="about-carousel-set" aria-hidden="true">
            <article class="about-card about-card-direct">
              <img src="img/about_carousel/Group 2136141923.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitDirectTitle']}</h3>
              <p>{m['home.benefitDirectText']}</p>
            </article>
            <article class="about-card about-card-legal">
              <img src="img/about_carousel/Group 2136141905.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitLegalTitle']}</h3>
              <p>{m['home.benefitLegalText']}</p>
            </article>
            <article class="about-card about-card-personal">
              <img src="img/about_carousel/Group 2136141924.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitPersonalTitle']}</h3>
              <p>{m['home.benefitPersonalText']}</p>
            </article>
            <article class="about-card about-card-locations">
              <img src="img/about_carousel/Group 2136141925.svg" alt="" class="about-card-icon">
              <h3>{m['home.benefitLocationTitle']}</h3>
              <p>{m['home.benefitLocationText']}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="golden-visa" class="golden-visa-section">
      <div class="container golden-container">
        <div class="golden-image-wrap">
          <div class="golden-carousel-3d">
            <div class="golden-carousel-inner">
              <div class="golden-carousel-face">
                <picture>
                  <source media="(max-width: 600px)" srcset="/img/figma-mobile/golden-visa.avif" type="image/avif">
                  <source media="(max-width: 600px)" srcset="/img/figma-mobile/golden-visa.png">
                  <source srcset="/img/figma_golden_visa.avif" type="image/avif">
                  <img src="/img/figma_golden_visa.png" alt={m['home.visaResidencyTitle']} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_2.avif" type="image/avif">
                  <img src="/img/golden_visa_2.png" alt={m['home.visaThresholdTitle']} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_3.avif" type="image/avif">
                  <img src="/img/golden_visa_3.png" alt={m['home.visaFamilyTitle']} loading="lazy" decoding="async">
                </picture>
              </div>
              <div class="golden-carousel-face">
                <picture>
                  <source srcset="/img/golden_visa_4.avif" type="image/avif">
                  <img src="/img/golden_visa_4.png" alt={m['home.visaSchengenTitle']} loading="lazy" decoding="async">
                </picture>
              </div>
            </div>
          </div>
          <a href={goldenVisaHref} class="visa-consult-badge glass-gradient">
            <span>{m['home.moreDetails']}</span>
            <span class="visa-consult-arrow"></span>
          </a>
        </div>

        <div class="golden-content">
          <h2 class="section-title">{m['common.goldenVisa']}</h2>
          <p class="section-subtitle">{m['home.visaDescription']}</p>

          <div class="slider-wrapper" aria-label={m['home.visaBenefits']}>
            <div class="slider-slides">
              <article class="slide active">
                <h3 class="slide-title">
                  <img src="img/golden_visa/Subtract_1.svg" alt="" class="slide-icon">
                  {m['home.visaResidencyTitle']}
                </h3>
                <p class="slide-text">{m['home.visaResidencyText']}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/trending-up_2.svg" alt="" class="slide-icon">
                  {m['home.visaThresholdTitle']}
                </h3>
                <p class="slide-text">{m['home.visaThresholdText']}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/Vector_3.svg" alt="" class="slide-icon">
                  {m['home.visaFamilyTitle']}
                </h3>
                <p class="slide-text">{m['home.visaFamilyText']}</p>
              </article>
              <article class="slide">
                <h3 class="slide-title">
                  <img src="img/golden_visa/keypad_4.svg" alt="" class="slide-icon">
                  {m['home.visaSchengenTitle']}
                </h3>
                <p class="slide-text slide-text-short">{m['home.visaSchengenText']}</p>
              </article>
            </div>

            <div class="slider-controls">
              <button class="slider-btn btn-prev" aria-label={m['home.visaPrevious']}></button>
              <span class="slider-counter">1/4</span>
              <button class="slider-btn btn-next" aria-label={m['home.visaNext']}></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="stages-section">
      <div class="container stages-container">
        <div class="stages-intro">
          <h2 class="section-title">{m['stages.title']}</h2>
          <p class="section-subtitle">{m['stages.description']}</p>
        </div>
      </div>

      <div class="stages-carousel" aria-label={m['stages.label']}>
        <div class="stages-carousel-track">
          <div class="stages-carousel-set">
            <article class="stage-card">
              <span class="stage-number">01</span>
              <h3>{m['stages.consultation']}</h3>
              <p>{m['stages.consultationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">02</span>
              <h3>{m['stages.reservation']}</h3>
              <p>{m['stages.reservationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">03</span>
              <h3>{m['stages.dueDiligence']}</h3>
              <p>{m['stages.dueDiligenceText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">04</span>
              <h3>{m['stages.purchase']}</h3>
              <p>{m['stages.purchaseText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">05</span>
              <h3>{m['stages.handover']}</h3>
              <p>{m['stages.handoverText']}</p>
            </article>
          </div>

          <div class="stages-carousel-set" aria-hidden="true">
            <article class="stage-card">
              <span class="stage-number">01</span>
              <h3>{m['stages.consultation']}</h3>
              <p>{m['stages.consultationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">02</span>
              <h3>{m['stages.reservation']}</h3>
              <p>{m['stages.reservationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">03</span>
              <h3>{m['stages.dueDiligence']}</h3>
              <p>{m['stages.dueDiligenceText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">04</span>
              <h3>{m['stages.contract']}</h3>
              <p>{m['stages.contractText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">05</span>
              <h3>{m['stages.handover']}</h3>
              <p>{m['stages.handoverText']}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="contacts" class="contacts-section">
      <div class="container">
        <div class="form-container">
          <h2 class="section-title">{m['form.title']}</h2>
          <p class="section-subtitle form-description-copy">
            {contactDescriptionLines.map((line) => <span>{line}</span>)}
          </p>

          <form class="consultation-form" data-consultation-form data-web3forms-key="bcf7cde0-e5e8-4908-8b89-02ebe78bcd0d" novalidate>
            <div class="form-row">
              <label class="form-group">
                <span>{m['form.name']}</span>
                <input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required>
              </label>
              <label class="form-group">
                <span>{m['form.phone']}</span>
                <input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40">
              </label>
              <label class="form-group">
                <span>{m['form.email']}</span>
                <input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254">
              </label>
            </div>

            <label class="form-group form-message">
              <span>{m['form.message']}</span>
              <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000"></textarea>
            </label>

            <label class="form-consent">
              <input type="checkbox" name="consent" class="form-consent-input" required>
              <span class="form-consent-box" aria-hidden="true"></span>
              <span class="form-consent-text">{m['form.consentBefore']} <a
                  href="#">{m['common.privacy']}</a> {m['form.consentAfter']}</span>
            </label>

            <div class="form-captcha"><div class="h-captcha" data-captcha="true" data-theme="light"></div></div>

            <button type="submit" class="btn-submit" disabled>
              <span>{m['form.submit']}</span>
              <span class="btn-submit-arrow"></span>
            </button>
            <input class="form-honeypot" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true">
            <p class="form-status" aria-live="polite" hidden></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-container">
      <div class="footer-top">
        <a href={homeHref} class="logo" aria-label={m['common.logoHome']}>
          <img src="img/logo_mark.svg" alt="" class="logo-img">
          <div class="logo-letters" aria-hidden="true">
            <img src="img/logo_letters/M.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/I.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/R.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/A.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/C.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/O.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/N.svg" alt="" class="logo-letter">
          </div>
        </a>
        <nav class="footer-socials" aria-label={m['common.contactLinks']}>
