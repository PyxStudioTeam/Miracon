---
import ProjectPage from '../../components/ProjectPage.astro';
import { getLocale } from '../../lib/i18n';
import { localizeProject } from '../../lib/projects';
import { cookieValue } from '../../lib/server/api';
import { findSession } from '../../lib/server/auth/session';
import { getDatabasePool } from '../../lib/server/database';
import { getAdminProjectBySlug } from '../../lib/server/projects';

const slug = Astro.params.slug ?? '';
const locale = getLocale(Astro.originPathname);
const sessionToken = cookieValue(Astro.request, '__Host-session');
if (!sessionToken || !await findSession(getDatabasePool(), sessionToken, new Date())) {
  return Astro.redirect('/admin');
}

const project = await getAdminProjectBySlug(getDatabasePool(), slug);

if (!project) {
  return Astro.redirect('/admin');
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<ProjectPage project={localizeProject(project, locale)} locale={locale} preview />
