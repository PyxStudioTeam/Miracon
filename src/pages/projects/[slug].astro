---
import ProjectPage from '../../components/ProjectPage.astro';
import { getLocale } from '../../lib/i18n';
import { getPublishedProjectBySlug, localizeProject } from '../../lib/projects';

const locale = getLocale(Astro.originPathname);
const sourceProject = await getPublishedProjectBySlug(Astro.params.slug ?? '');
const project = sourceProject ? localizeProject(sourceProject, locale) : null;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

if (!project) {
  return Astro.rewrite('/404');
}
---

<ProjectPage project={project} locale={locale} />
