---
import ProjectCard from '../components/ProjectCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SeoHead from '../components/SeoHead.astro';
import { getContactDescriptionLines, getLocale, getMessages, localizePath, oppositeLocale } from '../lib/i18n';
import { getPublishedProjects, localizeProject } from '../lib/projects';
import { absoluteLocalizedUrl } from '../lib/seo';
import { getSiteSettings } from '../lib/site-settings';

const locale = getLocale(Astro.originPathname);
const m = getMessages(locale);
const contactDescriptionLines = getContactDescriptionLines(locale);
const [sourceProjects, siteSettings] = await Promise.all([getPublishedProjects(), getSiteSettings()]);
const publishedProjects = sourceProjects.map((project) => localizeProject(project, locale));
const goldenVisaProjects = publishedProjects.filter((project) => project.categories.includes('golden-visa'));
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
const goldenVisaUrl = absoluteLocalizedUrl('/golden-visa', locale, Astro.url);
const homeHref = localizePath('/', locale);
const projectsHref = localizePath('/#projects', locale);
const aboutHref = localizePath('/#about', locale);
const topHref = localizePath('/golden-visa#top', locale);
const contactsHref = localizePath('/golden-visa#contacts', locale);
const languageHref = localizePath(`${Astro.originPathname}${Astro.url.search}`, oppositeLocale(locale));
const goldenVisaStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${goldenVisaUrl}#webpage`,
      url: goldenVisaUrl,
      name: m['gv.seoTitle'],
      description: m['gv.seoDescription'],
      inLanguage: locale,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: m['common.home'], item: absoluteLocalizedUrl('/', locale, Astro.url) },
        { '@type': 'ListItem', position: 2, name: m['common.goldenVisa'], item: goldenVisaUrl },
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang={locale}>

<head>
  <meta charset="UTF-8">
  <base href="/">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <SeoHead
    title={m['gv.seoTitle']}
    description={m['gv.seoDescription']}
    path="/golden-visa"
    image="/img/golden-visa/hero-interior.jpg"
    imageAlt={m['gv.seoImageAlt']}
    jsonLd={goldenVisaStructuredData}
    locale={locale}
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@qpokychuk/gilroy@1.0.2/index.min.css" rel="stylesheet">
  <link rel="preload" as="image" href="/img/golden-visa/hero-interior.avif" type="image/avif" fetchpriority="high">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/golden-visa.css">
  <link rel="stylesheet" href="/inner-mobile.css">
  <link rel="stylesheet" href="/shared-mobile-components.css">
</head>

<body class="golden-visa-page">
  <header class="header">
    <div class="header-container">
      <a href={homeHref} class="logo" aria-label={m['common.logoHome']}>
        <img src="img/logo_mark.svg" alt="" class="logo-img">
        <div class="logo-letters" aria-hidden="true">
          <img src="img/logo_letters/M.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/I.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/R.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/A.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/C.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/O.svg" alt="" class="logo-letter">
          <img src="img/logo_letters/N.svg" alt="" class="logo-letter">
        </div>
      </a>

      <nav class="nav-menu glass-gradient" aria-label={m['common.mainNavigation']}>
        <a href={projectsHref} class="nav-link">{m['common.projects']}</a>
        <a href={topHref} class="nav-link nav-link-current" aria-current="page">{m['common.goldenVisa']}</a>
        <a href={aboutHref} class="nav-link">{m['common.aboutUs']}</a>
        <a href={contactsHref} class="nav-link">{m['common.contacts']}</a>
      </nav>

      <div class="header-actions">
        <a class="lang-selector glass-gradient" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
          <span class="lang-current">{m['common.languageCode']}</span>
        </a>
        <div class="contact-menu">
          <a href={contactsHref} class="contact-btn" aria-haspopup="true">
            <span class="contact-btn-icon"></span>
            <span>{m['common.contact']}</span>
            <span class="contact-btn-arrow" aria-hidden="true">
              <img src="img/contact_header/Vector 12.svg" alt="">
            </span>
          </a>
          <div class="contact-dropdown" aria-label={m['common.quickContacts']}>
            <a href="tel:+306955340416" class="contact-dropdown-link contact-dropdown-link--phone"
              aria-label={m['common.callPhone']}>
              <span class="contact-dropdown-text">+306955340416</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Vector (1).svg" alt="">
              </span>
            </a>
            <a href="mailto:info@miracon.gr" class="contact-dropdown-link contact-dropdown-link--mail"
              aria-label={m['common.email']}>
              <span class="contact-dropdown-text">info@miracon.gr</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Group 37313 (1).svg" alt="">
              </span>
            </a>
            <a href="https://www.google.com/maps/search/?api=1&query=Egnatia+84%2C+54623+Thessaloniki%2C+Greece"
              class="contact-dropdown-link contact-dropdown-link--geo" target="_blank" rel="noreferrer"
              aria-label={m['common.openAddress']}>
              <span class="contact-dropdown-text">{m['common.address']}</span>
              <span class="contact-dropdown-circle" aria-hidden="true">
                <img src="img/contact_header/Vector (2).svg" alt="">
              </span>
            </a>
          </div>
        </div>
      </div>

      <a class="mobile-lang-selector" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
        <span>{m['common.languageCode']}</span>
      </a>
      <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label={m['common.openMenu']} aria-controls="mobileNav" aria-expanded="false">
        <span aria-hidden="true"></span>
      </button>
      <nav class="mobile-nav" id="mobileNav" aria-label={m['common.mobileNavigation']}>
        <a href={projectsHref} class="mobile-nav-link">{m['common.projects']}</a>
        <a href={topHref} class="mobile-nav-link" aria-current="page">{m['common.goldenVisa']}</a>
        <a href={aboutHref} class="mobile-nav-link">{m['common.aboutUs']}</a>
        <button class="mobile-nav-contact" type="button" aria-expanded="false" aria-controls="mobileContactDetails">
          <span>{m['common.contacts']}</span><span aria-hidden="true">+</span>
        </button>
        <div class="mobile-nav-contacts" id="mobileContactDetails">
          <a href="tel:+306955340416">+30 695 534 0416</a>
          <a href="mailto:info@miracon.gr">info@miracon.gr</a>
          <a href="https://www.google.com/maps/search/?api=1&query=Egnatia+84%2C+54623+Thessaloniki%2C+Greece" target="_blank" rel="noreferrer">{m['common.addressShort']}</a>
        </div>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="gv-hero" aria-labelledby="golden-visa-title">
      <OptimizedImage src="/img/golden-visa/hero-beach.jpg" alt="" class="gv-hero-bg gv-hero-bg-base" loading="lazy" decoding="async" />
      <OptimizedImage src="/img/golden-visa/hero-interior.jpg" alt={m['gv.heroImageAlt']} class="gv-hero-bg gv-hero-bg-front" loading="eager" fetchpriority="high" decoding="async" />
      <div class="gv-hero-softener" aria-hidden="true"></div>
      <div class="container gv-hero-content">
        <h1 id="golden-visa-title">{m['gv.heroTitleLine1']}<br>{m['gv.heroTitleLine2']}</h1>
        <p class="gv-hero-lead">{m['gv.heroText']}</p>
        <div class="gv-hero-actions hero-actions">
          <a href={projectsHref} class="btn-hero">
            <span class="btn-arrow btn-arrow-left"></span>
            <span>{m['home.exploreProjects']}</span>
          </a>
          <a href={projectsHref} class="badge-visa glass-gradient">{m['home.goldenVisaBadge']}</a>
        </div>
      </div>
    </section>

    <section class="gv-threshold" aria-labelledby="gv-threshold-title">
      <div class="container">
        <div class="gv-threshold-card">
          <div class="gv-threshold-main">
            <h2 id="gv-threshold-title">€250 000</h2>
            <p>{m['gv.thresholdText']}</p>
            <span>{m['gv.thresholdAffordable']}</span>
          </div>
          <span class="gv-threshold-divider" aria-hidden="true"></span>
          <div class="gv-threshold-note">
            <span class="gv-warning-icon" aria-hidden="true">
              <img src="img/golden-visa/warning-shape.svg" alt="" class="gv-warning-shape">
              <img src="img/golden-visa/warning-mark.svg" alt="" class="gv-warning-mark">
            </span>
            <p>{m['gv.thresholdNote']}&nbsp;
              <strong>€400,000</strong></p>
          </div>
        </div>
      </div>
    </section>

    <section class="gv-family" aria-labelledby="gv-family-title">
      <div class="container gv-family-container">
        <h2 id="gv-family-title" class="section-title">{m['gv.familyTitle']}</h2>
        <p class="section-subtitle">{m['gv.familyDescription']}</p>

        <div class="gv-family-panel">
          <a href={contactsHref} class="gv-primary-cta">
            <span>{m['gv.familyCta']}</span>
            <span class="btn-submit-arrow" aria-hidden="true"></span>
          </a>

          <div class="gv-family-cards">
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-children.svg" alt="" aria-hidden="true">
              <h3>{m['gv.spouse']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-parents.svg" alt="" aria-hidden="true">
              <h3>{m['gv.children']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-spouse.svg" alt="" aria-hidden="true">
              <h3>{m['gv.parents']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-application.svg" alt="" aria-hidden="true">
              <h3>{m['gv.oneApplication']}</h3>
            </article>
          </div>

          <div class="gv-family-summary">
            <img src="img/golden-visa/icon-application-large.svg" alt="" class="gv-family-summary-icon" aria-hidden="true">
            <div class="gv-family-summary-copy">
              <h3>{m['gv.familyInclusion']}</h3>
              <p>{m['gv.familyInclusionText']}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="gv-metrics" aria-label={m['gv.metricsLabel']}>
      <div class="gv-metrics-track">
        <div class="gv-metrics-set">
          <article class="gv-metric-card">
            <h3>{m['gv.countries']}</h3>
            <p>{m['gv.countriesText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>€250 000</h3>
            <p>{m['gv.minimumInvestment']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>{m['gv.fiveYears']}</h3>
            <p>{m['gv.durationText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>100%</h3>
            <p>{m['gv.guaranteeText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>~€20 000</h3>
            <p>{m['gv.chargesText']}</p>
          </article>
        </div>

        <div class="gv-metrics-set" aria-hidden="true">
          <article class="gv-metric-card">
            <h3>{m['gv.countries']}</h3>
            <p>{m['gv.countriesText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>€250 000</h3>
            <p>{m['gv.minimumInvestment']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>{m['gv.fiveYears']}</h3>
            <p>{m['gv.durationText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>100%</h3>
            <p>{m['gv.guaranteeText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>~€20 000</h3>
            <p>{m['gv.chargesText']}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="projects-section gv-projects">
      <div class="container">
        <h2 class="section-title">{goldenVisaProjects.length === 1 ? m['gv.featuredProperty'] : m['gv.properties']}</h2>
        <p class="section-subtitle">{m['gv.propertiesDescription']}</p>

        <div class="projects-list">
          {goldenVisaProjects.length > 0
            ? goldenVisaProjects.map((project) => <ProjectCard project={project} locale={locale} />)
            : <p class="gv-projects-empty">{m['gv.propertiesEmpty']}</p>}
        </div>
      </div>
    </section>

    <section class="stages-section">
      <div class="container stages-container">
        <div class="stages-intro">
          <h2 class="section-title">{m['stages.title']}</h2>
          <p class="section-subtitle">{m['stages.description']}</p>
        </div>
      </div>

      <div class="stages-carousel" aria-label={m['stages.label']}>
        <div class="stages-carousel-track">
          <div class="stages-carousel-set">
            <article class="stage-card">
              <span class="stage-number">01</span>
              <h3>{m['stages.consultation']}</h3>
              <p>{m['stages.consultationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">02</span>
              <h3>{m['stages.reservation']}</h3>
              <p>{m['stages.reservationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">03</span>
              <h3>{m['stages.dueDiligence']}</h3>
              <p>{m['stages.dueDiligenceText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">04</span>
              <h3>{m['stages.contract']}</h3>
              <p>{m['stages.contractText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">05</span>
              <h3>{m['stages.handover']}</h3>
              <p>{m['stages.handoverText']}</p>
            </article>
          </div>

          <div class="stages-carousel-set" aria-hidden="true">
            <article class="stage-card">
              <span class="stage-number">01</span>
              <h3>{m['stages.consultation']}</h3>
              <p>{m['stages.consultationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">02</span>
              <h3>{m['stages.reservation']}</h3>
              <p>{m['stages.reservationText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">03</span>
              <h3>{m['stages.dueDiligence']}</h3>
              <p>{m['stages.dueDiligenceText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">04</span>
              <h3>{m['stages.contract']}</h3>
              <p>{m['stages.contractText']}</p>
            </article>
            <article class="stage-card">
              <span class="stage-number">05</span>
              <h3>{m['stages.handover']}</h3>
              <p>{m['stages.handoverText']}</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section id="contacts" class="contacts-section">
      <div class="container">
        <div class="form-container">
          <h2 class="section-title">{m['form.title']}</h2>
          <p class="section-subtitle form-description-copy">
            {contactDescriptionLines.map((line) => <span>{line}</span>)}
          </p>

          <form class="consultation-form" data-consultation-form data-web3forms-key="bcf7cde0-e5e8-4908-8b89-02ebe78bcd0d" novalidate>
            <div class="form-row">
              <label class="form-group">
                <span>{m['form.name']}</span>
                <input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required>
              </label>
              <label class="form-group">
                <span>{m['form.phone']}</span>
                <input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40">
              </label>
              <label class="form-group">
                <span>{m['form.email']}</span>
                <input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254">
              </label>
            </div>

            <label class="form-group form-message">
              <span>{m['form.message']}</span>
              <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000"></textarea>
            </label>

            <label class="form-consent">
              <input type="checkbox" name="consent" class="form-consent-input" required>
              <span class="form-consent-box" aria-hidden="true"></span>
              <span class="form-consent-text">{m['form.consentBefore']} <a
                  href="#">{m['common.privacy']}</a> {m['form.consentAfter']}</span>
            </label>

            <div class="form-captcha"><div class="h-captcha" data-captcha="true" data-theme="light"></div></div>

            <button type="submit" class="btn-submit" disabled>
              <span>{m['form.submit']}</span>
              <span class="btn-submit-arrow"></span>
            </button>
            <input class="form-honeypot" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true">
            <p class="form-status" aria-live="polite" hidden></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-container">
      <div class="footer-top">
        <a href={homeHref} class="logo" aria-label={m['common.logoHome']}>
          <img src="img/logo_mark.svg" alt="" class="logo-img">
          <div class="logo-letters" aria-hidden="true">
            <img src="img/logo_letters/M.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/I.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/R.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/A.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/C.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/O.svg" alt="" class="logo-letter">
            <img src="img/logo_letters/N.svg" alt="" class="logo-letter">
          </div>
        </a>
        <nav class="footer-socials" aria-label={m['common.contactLinks']}>
          <a href="mailto:info@miracon.gr" aria-label={m['common.email']} title="info@miracon.gr">
            <img src="img/contact_header/Group 37313 (1).svg" alt="">
          </a>
          <a href="tel:+306955340416" aria-label={m['common.callPhone']} title="+30 695 534 0416">
            <img src="img/contact_header/Vector (1).svg" alt="">
          </a>
          <a href="https://wa.me/306955340416" target="_blank" rel="noreferrer" aria-label="WhatsApp +30 695 534 0416" title="WhatsApp">
            <img src="img/footer-whatsapp.svg" alt="">
          </a>
        </nav>
      </div>
      <div class="footer-bottom">
        <div class:list={['footer-links', { 'footer-links--empty': !siteSettings.footerTermsVisible && !siteSettings.footerPrivacyVisible && !siteSettings.footerCookieVisible }]}>
          <a href={siteSettings.footerTermsPdfUrl || '#'} target={siteSettings.footerTermsPdfUrl ? '_blank' : undefined} rel={siteSettings.footerTermsPdfUrl ? 'noreferrer' : undefined} hidden={!siteSettings.footerTermsVisible}>{m['common.terms']}</a>
          <a href={siteSettings.footerPrivacyPdfUrl || '#'} target={siteSettings.footerPrivacyPdfUrl ? '_blank' : undefined} rel={siteSettings.footerPrivacyPdfUrl ? 'noreferrer' : undefined} hidden={!siteSettings.footerPrivacyVisible}>{m['common.privacy']}</a>
          <a href={siteSettings.footerCookiePdfUrl || '#'} target={siteSettings.footerCookiePdfUrl ? '_blank' : undefined} rel={siteSettings.footerCookiePdfUrl ? 'noreferrer' : undefined} hidden={!siteSettings.footerCookieVisible}>{m['common.cookies']}</a>
        </div>
        <a class="lang-dropdown-btn" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
          <span>{m['common.languageName']}</span>
          <span class="lang-refresh" aria-hidden="true">
            <img src="img/Vector.svg" alt="">
          </span>
        </a>
      </div>
      <p class="footer-copyright">{m['common.copyright']}</p>
    </div>
  </footer>

  <script is:inline src="https://web3forms.com/client/script.js" async defer></script>
  <script is:inline src="/site.js"></script>
</body>

</html>
