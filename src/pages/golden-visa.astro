---
import ProjectCard from '../components/ProjectCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StagesCarousel from '../components/StagesCarousel.astro';
import SeoHead from '../components/SeoHead.astro';
import { getContactDescriptionLines, getLocale, getMessages, localizePath } from '../lib/i18n';
import { getPublishedProjects, localizeProject } from '../lib/projects';
import { absoluteLocalizedUrl } from '../lib/seo';
import { defaultSiteSettings, getSiteSettings } from '../lib/site-settings';
import { brandCopy, brandThemeStyle } from '../lib/site-settings-shared';

const locale = getLocale(Astro.originPathname);
const m = getMessages(locale);
// Preserve the consultation form's original line breaks until its copy is edited.
const [sourceProjects, siteSettings] = await Promise.all([getPublishedProjects(), getSiteSettings()]);
const copy = siteSettings.goldenVisaCopy[locale];
const contactCopy = siteSettings.contactCopy[locale];
const publishedProjects = sourceProjects.map((project) => localizeProject(project, locale));
const goldenVisaProjects = publishedProjects.filter((project) => project.categories.includes('golden-visa'));
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
const goldenVisaUrl = absoluteLocalizedUrl('/golden-visa', locale, Astro.url);
const projectsHref = localizePath('/#projects', locale);
const contactsHref = localizePath('/golden-visa#contacts', locale);
const privacyPolicyHref = siteSettings.footerPrivacyPdfUrl;
const goldenVisaStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${goldenVisaUrl}#webpage`,
      url: goldenVisaUrl,
      name: brandCopy(m['gv.seoTitle'], siteSettings),
      description: brandCopy(m['gv.seoDescription'], siteSettings),
      inLanguage: locale,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: m['common.home'], item: absoluteLocalizedUrl('/', locale, Astro.url) },
        { '@type': 'ListItem', position: 2, name: m['common.goldenVisa'], item: goldenVisaUrl },
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang={locale} style={brandThemeStyle(siteSettings)}>

<head>
  <meta charset="UTF-8">
  <base href="/">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SeoHead
    title={brandCopy(m['gv.seoTitle'], siteSettings)}
    description={brandCopy(m['gv.seoDescription'], siteSettings)}
    path="/golden-visa"
    image="/img/golden-visa/hero-interior.jpg"
    imageAlt={m['gv.seoImageAlt']}
    jsonLd={goldenVisaStructuredData}
    siteName={siteSettings.siteName}
    locale={locale}
    logoUrl={siteSettings.logoUrl}
    brandColor={siteSettings.brandColor}
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@qpokychuk/gilroy@1.0.2/index.min.css" rel="stylesheet">
  <link rel="preload" as="image" href="/img/golden-visa/hero-interior.avif" type="image/avif" fetchpriority="high">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/golden-visa.css">
  <link rel="stylesheet" href="/inner-mobile.css">
  <link rel="stylesheet" href="/shared-mobile-components.css">
</head>

<body class="golden-visa-page">
  <SiteHeader locale={locale} settings={siteSettings} goldenVisaActive />

  <main id="top">
    <section class="gv-hero" aria-labelledby="golden-visa-title">
      <OptimizedImage src="/img/golden-visa/hero-beach.jpg" alt="" class="gv-hero-bg gv-hero-bg-base" loading="lazy" decoding="async" />
      <OptimizedImage src="/img/golden-visa/hero-interior.jpg" alt={m['gv.heroImageAlt']} class="gv-hero-bg gv-hero-bg-front" loading="eager" fetchpriority="high" decoding="async" />
      <div class="gv-hero-softener" aria-hidden="true"></div>
      <div class="container gv-hero-content">
        <h1 id="golden-visa-title">{copy.heroTitleLine1}<br>{copy.heroTitleLine2}</h1>
        <p class="gv-hero-lead">{brandCopy(copy.heroText, siteSettings)}</p>
        <div class="gv-hero-actions hero-actions">
          <a href={projectsHref} class="btn-hero">
            <span class="btn-arrow btn-arrow-left"></span>
            <span>{m['home.exploreProjects']}</span>
          </a>
          <a href={projectsHref} class="badge-visa glass-gradient">{m['home.goldenVisaBadge']}</a>
        </div>
      </div>
    </section>

    <section class="gv-threshold" aria-labelledby="gv-threshold-title">
      <div class="container">
        <div class="gv-threshold-card">
          <div class="gv-threshold-main">
            <h2 id="gv-threshold-title">€250 000</h2>
            <p>{copy.thresholdText}</p>
            <span>{copy.thresholdAffordable}</span>
          </div>
          <span class="gv-threshold-divider" aria-hidden="true"></span>
          <div class="gv-threshold-note">
            <span class="gv-warning-icon" aria-hidden="true">
              <img src="img/golden-visa/warning-shape.svg" alt="" class="gv-warning-shape">
              <img src="img/golden-visa/warning-mark.svg" alt="" class="gv-warning-mark">
            </span>
            <p>{copy.thresholdNote}&nbsp;
              <strong>€400,000</strong></p>
          </div>
        </div>
      </div>
    </section>

    <section class="gv-family" aria-labelledby="gv-family-title">
      <div class="container gv-family-container">
        <h2 id="gv-family-title" class="section-title">{copy.familyTitle}</h2>
        <p class="section-subtitle">{copy.familyDescription}</p>

        <div class="gv-family-panel">
          <a href={contactsHref} class="gv-primary-cta">
            <span>{m['gv.familyCta']}</span>
            <span class="btn-submit-arrow" aria-hidden="true"></span>
          </a>

          <div class="gv-family-cards">
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-children.svg" alt="" aria-hidden="true">
              <h3>{m['gv.spouse']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-parents.svg" alt="" aria-hidden="true">
              <h3>{m['gv.children']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-spouse.svg" alt="" aria-hidden="true">
              <h3>{m['gv.parents']}</h3>
            </article>
            <article class="gv-family-card">
              <img src="img/golden-visa/icon-application.svg" alt="" aria-hidden="true">
              <h3>{m['gv.oneApplication']}</h3>
            </article>
          </div>

          <div class="gv-family-summary">
            <img src="img/golden-visa/icon-application-large.svg" alt="" class="gv-family-summary-icon" aria-hidden="true">
            <div class="gv-family-summary-copy">
              <h3>{copy.familyInclusion}</h3>
              <p>{copy.familyInclusionText}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="gv-metrics" aria-label={m['gv.metricsLabel']}>
      <div class="gv-metrics-track">
        <div class="gv-metrics-set">
          <article class="gv-metric-card">
            <h3>{m['gv.countries']}</h3>
            <p>{m['gv.countriesText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>€250 000</h3>
            <p>{m['gv.minimumInvestment']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>{m['gv.fiveYears']}</h3>
            <p>{m['gv.durationText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>100%</h3>
            <p>{m['gv.guaranteeText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>~€20 000</h3>
            <p>{m['gv.chargesText']}</p>
          </article>
        </div>

        <div class="gv-metrics-set" aria-hidden="true">
          <article class="gv-metric-card">
            <h3>{m['gv.countries']}</h3>
            <p>{m['gv.countriesText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>€250 000</h3>
            <p>{m['gv.minimumInvestment']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>{m['gv.fiveYears']}</h3>
            <p>{m['gv.durationText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>100%</h3>
            <p>{m['gv.guaranteeText']}</p>
          </article>
          <article class="gv-metric-card">
            <h3>~€20 000</h3>
            <p>{m['gv.chargesText']}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="projects-section gv-projects">
      <div class="container">
        <h2 class="section-title">{goldenVisaProjects.length === 1 ? copy.featuredProperty : copy.properties}</h2>
        <p class="section-subtitle">{copy.propertiesDescription}</p>

        <div class="projects-list">
          {goldenVisaProjects.length > 0
            ? goldenVisaProjects.map((project) => <ProjectCard project={project} locale={locale} />)
            : <p class="gv-projects-empty">{m['gv.propertiesEmpty']}</p>}
        </div>
      </div>
    </section>

    <StagesCarousel settings={siteSettings} locale={locale} />

    <section id="contacts" class="contacts-section">
      <div class="container">
        <div class="form-container">
          <h2 class="section-title">{contactCopy.title}</h2>
          <p class="section-subtitle form-description-copy">
            {contactCopy.description === defaultSiteSettings.contactCopy[locale].description
              ? getContactDescriptionLines(locale).map((line) => <span>{line}</span>)
              : <span>{contactCopy.description}</span>}
          </p>

          <form class="consultation-form" data-consultation-form novalidate>
            <div class="form-row">
              <label class="form-group">
                <span>{m['form.name']} *</span>
                <input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required>
              </label>
              <label class="form-group">
                <span>{m['form.phone']} *</span>
                <input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40" required>
              </label>
              <label class="form-group">
                <span>{m['form.email']} *</span>
                <input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254" required>
              </label>
            </div>

            <label class="form-group form-message">
              <span>{m['form.message']} *</span>
              <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000" required></textarea>
            </label>

            <label class="form-consent">
              <input type="checkbox" name="consent" class="form-consent-input" required disabled={!privacyPolicyHref}>
              <span class="form-consent-box" aria-hidden="true"></span>
              <span class="form-consent-text">{privacyPolicyHref
                ? <>{m['form.consentBefore']} <a href={privacyPolicyHref} target="_blank" rel="noopener noreferrer">{m['common.privacy']}</a> {m['form.consentAfter']}</>
                : m['form.policyUnavailable']}</span>
            </label>

            <button type="submit" class="btn-submit" disabled>
              <span>{m['form.submit']}</span>
              <span class="btn-submit-arrow"></span>
            </button>
            <input class="form-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
            <p class="form-status" aria-live="polite" hidden></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} settings={siteSettings} />

  <script is:inline src="/site.js"></script>
</body>

</html>
