---
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocale, getMessages, localizePath } from '../lib/i18n';
import { getSiteSettings } from '../lib/site-settings';

const locale = getLocale(Astro.originPathname);
const isGreek = locale === 'el';
const m = getMessages(locale);
const siteSettings = await getSiteSettings();

const pageTitle = isGreek
  ? `Πολιτική Απορρήτου — ${siteSettings.siteName}`
  : `Privacy Policy — ${siteSettings.siteName}`;
const pageDescription = isGreek
  ? 'Ενημερωθείτε για την πολιτική απορρήτου και την προστασία των προσωπικών δεδομένων σας από τη MIRACON Μονοπρόσωπη Ι.Κ.Ε.'
  : 'Learn about how MIRACON protects and processes your personal data in accordance with the GDPR.';
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <SeoHead
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    siteName={siteSettings.siteName}
  />
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/mobile.css">
  <link rel="stylesheet" href="/shared-mobile-components.css">
</head>
<body class="legal-page">
  <SiteHeader locale={locale} settings={siteSettings} />

  <main class="legal-main">
    <div class="container legal-container">
      <nav class="legal-breadcrumbs" aria-label="Breadcrumbs">
        <a href={localizePath('/', locale)}>{m['common.home']}</a>
        <span aria-hidden="true">/</span>
        <span>{m['common.privacy']}</span>
      </nav>

      {isGreek ? (
        <article class="legal-article">
          <header class="legal-header">
            <h1>ΠΟΛΙΤΙΚΗ ΑΠΟΡΡΗΤΟΥ — miracon.gr</h1>
            <p class="legal-date">Τελευταία ενημέρωση: 15.09.2026</p>
          </header>

          <section>
            <h2>1. Ποιοι είμαστε</h2>
            <p>
              Τον ιστότοπο <strong>miracon.gr</strong> διαχειρίζεται η <strong>MIRACON ΜΟΝΟΠΡΟΣΩΠΗ ΙΔΙΩΤΙΚΗ ΚΕΦΑΛΑΙΟΥΧΙΚΗ ΕΤΑΙΡΕΙΑ (Μονοπρόσωπη Ι.Κ.Ε.)</strong> («εμείς»), με έδρα στην Ελλάδα, διεύθυνση έδρας: Εγνατίας 84, 54630 Θεσσαλονίκη, νόμιμα εκπροσωπούμενη από τον διαχειριστή της Συμεών Ιωσηφίδη. <strong>ΑΦΜ: 802235911</strong>. Είμαστε ο υπεύθυνος επεξεργασίας των προσωπικών δεδομένων που υποβάλλονται μέσω αυτού του ιστότοπου.
            </p>
            <p>
              Για κάθε ερώτημα σχετικά με την παρούσα πολιτική ή τα δεδομένα σας, επικοινωνήστε στο <a href="mailto:info@miracon.gr">info@miracon.gr</a> ή στο <a href="tel:+306955340416">+30 695 534 0416</a>, ή ταχυδρομικά στην παραπάνω διεύθυνση. Δεν έχουμε ορίσει Υπεύθυνο Προστασίας Δεδομένων.
            </p>
          </section>

          <section>
            <h2>2. Ποια δεδομένα συλλέγουμε</h2>
            <p>
              <strong>2.1 Δεδομένα που παρέχετε εσείς.</strong> Μέσω της φόρμας επικοινωνίας συλλέγουμε: το όνομά σας· τον αριθμό τηλεφώνου ή/και τη διεύθυνση email σας· το περιεχόμενο του μηνύματός σας· καθώς και το γεγονός και τον χρόνο της συγκατάθεσής σας στην παρούσα πολιτική. Η παροχή αυτών των δεδομένων είναι προαιρετική, όμως χρειαζόμαστε το όνομά σας και τουλάχιστον ένα στοιχείο επικοινωνίας για να απαντήσουμε.
            </p>
            <p>
              <strong>2.2 Δεδομένα που συλλέγονται αυτόματα.</strong> Ο πάροχος φιλοξενίας μας καταγράφει τυπικά αρχεία καταγραφής διακομιστή: τη διεύθυνση IP σας, την ημερομηνία και ώρα του αιτήματος, τις σελίδες που είδατε, τον ιστότοπο παραπομπής και τον τύπο του προγράμματος περιήγησης/συσκευής.
            </p>
            <p>
              <strong>2.3 Cookies και παρόμοιες τεχνολογίες.</strong> Ο παρών ιστότοπος δεν τοποθετεί δικά του cookies και δεν χρησιμοποιεί τεχνολογίες ανάλυσης επισκεψιμότητας, διαφήμισης ή ιχνηλάτησης. Στοιχεία που φορτώνονται από τρίτους ενδέχεται να τοποθετούν δικά τους cookies ή να διαβάζουν αναγνωριστικά συσκευής και σε κάθε περίπτωση λαμβάνουν τη διεύθυνση IP σας:
            </p>
            <ul>
              <li><strong>Google Fonts</strong> (Google Ireland Ltd / Google LLC) και το δίκτυο διανομής περιεχομένου <strong>jsDelivr</strong>, από τα οποία φορτώνονται γραμματοσειρές και στυλ.</li>
              <li><strong>Χάρτες Google.</strong> Στις σελίδες των έργων μας ο χάρτης είναι ενσωματωμένος απευθείας στη σελίδα και φορτώνεται αυτόματα καθώς κάνετε κύλιση προς αυτόν, επομένως η Google λαμβάνει τη διεύθυνση IP σας ακόμη και αν δεν αλληλεπιδράσετε με τον χάρτη. Η διεύθυνσή μας εμφανίζεται επιπλέον ως σύνδεσμος προς τους Χάρτες Google· αν τον πατήσετε, οι Χάρτες Google ανοίγουν στον ιστότοπο της Google.</li>
              <li><strong>Εικονικές περιηγήσεις.</strong> Στις σελίδες των έργων ενσωματώνουμε εικονικές περιηγήσεις 360° που φιλοξενούνται στο storage.net-fs.com (μέσω υποδομής Google Cloud). Η περιήγηση φορτώνεται από τον πάροχο αυτόν, ο οποίος επομένως λαμβάνει τη διεύθυνση IP σας. Ορισμένες περιηγήσεις ενσωματώνουν επιπλέον τρισδιάστατα μοντέλα από το sketchfab.com, το οποίο λαμβάνει τη διεύθυνση IP σας κατά τη φόρτωση του μοντέλου.</li>
            </ul>
          </section>

          <section>
            <h2>3. Γιατί επεξεργαζόμαστε τα δεδομένα σας και η νομική βάση</h2>
            <ul>
              <li>Για να απαντήσουμε στο αίτημά σας και να σας παρέχουμε τις πληροφορίες ή τη συμβουλευτική που ζητήσατε — η συγκατάθεσή σας (άρθρο 6 παρ. 1 στοιχ. α΄ ΓΚΠΔ) ή/και ενέργειες κατόπιν αιτήματός σας πριν από τη σύναψη σύμβασης (άρθρο 6 παρ. 1 στοιχ. β΄).</li>
              <li>Για την προστασία της φόρμας από ανεπιθύμητα μηνύματα και καταχρήσεις, μέσω δικού μας μηχανισμού που λειτουργεί στον διακομιστή μας — το έννομο συμφέρον μας (άρθρο 6 παρ. 1 στοιχ. στ΄).</li>
              <li>Για την τήρηση αρχείων καταγραφής διακομιστή για την ασφάλεια και τη λειτουργία του ιστότοπου — το έννομο συμφέρον μας (άρθρο 6 παρ. 1 στοιχ. στ΄).</li>
              <li>Για τη συμμόρφωση με νομικές υποχρεώσεις — άρθρο 6 παρ. 1 στοιχ. γ΄.</li>
            </ul>
            <p>
              Δεν χρησιμοποιούμε τα δεδομένα σας για αυτοματοποιημένη λήψη αποφάσεων, κατάρτιση προφίλ ή προώθηση άσχετων προϊόντων, και δεν πουλάμε προσωπικά δεδομένα.
            </p>
          </section>

          <section>
            <h2>4. Για πόσο διατηρούμε τα δεδομένα σας</h2>
            <p>
              <strong>Δεδομένα αιτημάτων</strong> (μηνύματα φόρμας και σχετική αλληλογραφία): 24 μήνες από την τελευταία επικοινωνία μαζί σας, και στη συνέχεια διαγράφονται ή ανωνυμοποιούνται — εκτός εάν απαιτείται μεγαλύτερο διάστημα για νομικές αξιώσεις ή νομική υποχρέωση.
            </p>
            <p>
              <strong>Αρχεία καταγραφής διακομιστή:</strong> έως 12 μήνες.
            </p>
            <p>Μπορείτε να μας ζητήσετε να διαγράψουμε νωρίτερα τα δεδομένα του αιτήματός σας.</p>
          </section>

          <section>
            <h2>5. Ποιοι λαμβάνουν τα δεδομένα σας</h2>
            <p>Κοινοποιούμε προσωπικά δεδομένα μόνο όπου είναι απαραίτητο, σε:</p>
            <ul>
              <li>τον δικό μας διακομιστή, όπου το μήνυμα που στέλνετε μέσω της φόρμας αποθηκεύεται στη βάση δεδομένων μας. Η φόρμα δεν υποβάλλεται σε καμία εξωτερική υπηρεσία φορμών.</li>
              <li>το Google Fonts (Google Ireland Ltd / Google LLC) και το δίκτυο διανομής περιεχομένου jsDelivr, τα οποία λαμβάνουν τη διεύθυνση IP σας κατά τη φόρτωση γραμματοσειρών και στυλ·</li>
              <li>την Google (Google Ireland Ltd / Google LLC), η οποία λαμβάνει τη διεύθυνση IP σας κατά τη φόρτωση του ενσωματωμένου χάρτη σε σελίδα έργου·</li>
              <li>το storage.net-fs.com, που φιλοξενεί τις ενσωματωμένες εικονικές περιηγήσεις 360°, και το sketchfab.com, που φιλοξενεί τρισδιάστατα μοντέλα ενσωματωμένα σε ορισμένες περιηγήσεις — και τα δύο λαμβάνουν τη διεύθυνση IP σας κατά τη φόρτωση του περιεχομένου·</li>
              <li>τον πάροχο φιλοξενίας μας, με διακομιστές στη Γερμανία·</li>
              <li>επαγγελματίες συμβούλους και δημόσιες αρχές, όπου απαιτείται από τον νόμο.</li>
            </ul>
            <p>Οι εκτελούντες την επεξεργασία ενεργούν βάσει γραπτών συμβάσεων και μόνο κατ’ εντολή μας. Δεν πουλάμε προσωπικά δεδομένα.</p>
          </section>

          <section>
            <h2>6. Διαβιβάσεις εκτός ΕΟΧ</h2>
            <p>
              Ορισμένοι από τους παραπάνω παρόχους (ιδίως η Google, το δίκτυο jsDelivr, το storage.net-fs.com και το sketchfab.com) ενδέχεται να επεξεργάζονται δεδομένα εκτός του Ευρωπαϊκού Οικονομικού Χώρου, κυρίως στις ΗΠΑ. Για τέτοιες διαβιβάσεις βασιζόμαστε σε κατάλληλες εγγυήσεις, ιδίως στις Τυποποιημένες Συμβατικές Ρήτρες της Ευρωπαϊκής Επιτροπής και, όπου ισχύει, στο Πλαίσιο Προστασίας Δεδομένων ΕΕ–ΗΠΑ. Μπορείτε να ζητήσετε αντίγραφο με τα στοιχεία επικοινωνίας της ενότητας 1.
            </p>
          </section>

          <section>
            <h2>7. Τα δικαιώματά σας</h2>
            <p>
              Έχετε το δικαίωμα: πρόσβασης στα δεδομένα σας· διόρθωσης ανακριβών δεδομένων· διαγραφής των δεδομένων σας· περιορισμού ή εναντίωσης στην επεξεργασία· λήψης των δεδομένων σας σε φορητή μορφή· και ανάκλησης της συγκατάθεσής σας ανά πάσα στιγμή (χωρίς να θίγεται η επεξεργασία που έγινε πριν από την ανάκληση).
            </p>
            <p>
              Για να ασκήσετε ένα δικαίωμα, γράψτε στο <a href="mailto:info@miracon.gr">info@miracon.gr</a>. Απαντούμε εντός ενός μηνός (με δυνατότητα παράτασης κατά δύο μήνες για σύνθετα αιτήματα, κατόπιν ενημέρωσης).
            </p>
            <p>
              Εάν θεωρείτε ότι δεν χειριστήκαμε σωστά τα δεδομένα σας, μπορείτε να υποβάλετε καταγγελία στην <strong>Αρχή Προστασίας Δεδομένων Προσωπικού Χαρακτήρα</strong> — Λεωφ. Κηφισίας 1-3, 115 23 Αθήνα, +30 210 6475600, <a href="mailto:complaints@dpa.gr">complaints@dpa.gr</a>, <a href="https://www.dpa.gr" target="_blank" rel="noreferrer">www.dpa.gr</a> — ή στην αρχή της χώρας διαμονής σας στην ΕΕ.
            </p>
          </section>

          <section>
            <h2>8. Ασφάλεια</h2>
            <p>
              Λαμβάνουμε εύλογα τεχνικά και οργανωτικά μέτρα, μεταξύ άλλων κρυπτογράφηση HTTPS και ελέγχους πρόσβασης. Καμία μετάδοση μέσω διαδικτύου δεν είναι απολύτως ασφαλής.
            </p>
          </section>

          <section>
            <h2>9. Παιδιά</h2>
            <p>
              Ο ιστότοπος απευθύνεται σε ενήλικες. Δεν συλλέγουμε εν γνώσει μας δεδομένα από παιδιά κάτω των 15 ετών. Εάν κάποιο παιδί μάς έχει δώσει δεδομένα, επικοινωνήστε μαζί μας και θα τα διαγράψουμε.
            </p>
          </section>

          <section>
            <h2>10. Αλλαγές</h2>
            <p>
              Ενδέχεται να επικαιροποιήσουμε την παρούσα πολιτική. Η ισχύουσα έκδοση, με την ημερομηνία της, βρίσκεται πάντοτε σε αυτή τη σελίδα· ουσιώδεις αλλαγές θα επισημαίνονται στον ιστότοπο.
            </p>
          </section>

          <section>
            <h2>11. Επικοινωνία</h2>
            <p>
              <strong>MIRACON ΜΟΝΟΠΡΟΣΩΠΗ ΙΔΙΩΤΙΚΗ ΚΕΦΑΛΑΙΟΥΧΙΚΗ ΕΤΑΙΡΕΙΑ (Μονοπρόσωπη Ι.Κ.Ε.)</strong><br>
              Εγνατίας 84, 54630 Θεσσαλονίκη, Ελλάδα<br>
              Email: <a href="mailto:info@miracon.gr">info@miracon.gr</a><br>
              Τηλέφωνο: <a href="tel:+306955340416">+30 695 534 0416</a>
            </p>
          </section>
        </article>
      ) : (
        <article class="legal-article">
          <header class="legal-header">
            <h1>PRIVACY POLICY — miracon.gr</h1>
            <p class="legal-date">Last updated: 15.09.2026</p>
          </header>

          <section>
            <h2>1. Who we are</h2>
            <p>
              This website, <strong>miracon.gr</strong>, is operated by <strong>MIRACON Single-Member Private Capital Company (Μονοπρόσωπη Ι.Κ.Ε.)</strong> ("we", "us"), a company established in Greece, registered office: 84 Egnatias Street, 54630 Thessaloniki, Greece, legally represented by its Manager Symeon Iosifidis. <strong>Tax Registration Number (ΑΦΜ): 802235911</strong>. We are the controller of the personal data processed through this website.
            </p>
            <p>
              For any question about this policy or your data, contact us at <a href="mailto:info@miracon.gr">info@miracon.gr</a> or <a href="tel:+306955340416">+30 695 534 0416</a>, or by post at the address above. We have not appointed a Data Protection Officer.
            </p>
          </section>

          <section>
            <h2>2. What data we collect</h2>
            <p>
              <strong>2.1 Data you provide.</strong> Through the contact form we collect: your name; your phone number and/or email address; the content of your message; and the fact and time of your consent to this policy. Providing this data is voluntary, but we need your name and at least one contact detail to reply.
            </p>
            <p>
              <strong>2.2 Data collected automatically.</strong> Our hosting provider records standard server logs: your IP address, the date and time of the request, the pages viewed, the referring site, and your browser and device type.
            </p>
            <p>
              <strong>2.3 Cookies and similar technologies.</strong> This website does not set any cookies of its own and uses no analytics, advertising or tracking technologies. Components loaded from third parties may set their own cookies or read device identifiers, and in any case receive your IP address:
            </p>
            <ul>
              <li><strong>Google Fonts</strong> (Google Ireland Ltd / Google LLC) and the <strong>jsDelivr</strong> content delivery network, from which fonts and styles are loaded.</li>
              <li><strong>Google Maps.</strong> On our project pages a map is embedded directly in the page and loads automatically as you scroll to it, so Google receives your IP address even if you never interact with the map. Our address is additionally shown as a link to Google Maps; if you click it, Google Maps opens on Google’s own site.</li>
              <li><strong>Virtual tours.</strong> On project pages we embed 360° virtual tours hosted by storage.net-fs.com (served from Google Cloud infrastructure). The tour loads from that provider, which therefore receives your IP address. Some tours additionally embed 3D models from sketchfab.com, which receives your IP address when such a model loads.</li>
            </ul>
          </section>

          <section>
            <h2>3. Why we process your data and our legal basis</h2>
            <ul>
              <li>To reply to your enquiry and provide the information or consultation you asked for — your consent (GDPR Art. 6(1)(a)) and/or steps taken at your request before entering a contract (Art. 6(1)(b)).</li>
              <li>To protect the form from spam and abuse, using our own anti-spam mechanism running on our server — our legitimate interest (Art. 6(1)(f)).</li>
              <li>To keep server logs for the security and operation of the site — our legitimate interest (Art. 6(1)(f)).</li>
              <li>To comply with legal obligations — Art. 6(1)(c).</li>
            </ul>
            <p>
              We do not use your data for automated decision-making, profiling or marketing of unrelated products, and we do not sell personal data.
            </p>
          </section>

          <section>
            <h2>4. How long we keep your data</h2>
            <p>
              <strong>Enquiry data</strong> (form messages and related correspondence): 24 months from our last contact with you, then deleted or anonymised — unless a longer period is needed for legal claims or a legal obligation.
            </p>
            <p>
              <strong>Server logs:</strong> up to 12 months.
            </p>
            <p>You may ask us to delete your enquiry data sooner.</p>
          </section>

          <section>
            <h2>5. Who receives your data</h2>
            <p>We share personal data only as necessary, with:</p>
            <ul>
              <li>our own server, where the message you send through the form is stored in our database. The form is not processed by any third-party form service.</li>
              <li>Google Fonts (Google Ireland Ltd / Google LLC) and the jsDelivr CDN, which receive your IP address when fonts and styles load;</li>
              <li>Google (Google Ireland Ltd / Google LLC), which receives your IP address when the embedded map on a project page loads;</li>
              <li>storage.net-fs.com, which hosts the embedded 360° virtual tours, and sketchfab.com, which hosts 3D models embedded inside some tours — both receive your IP address when the content loads;</li>
              <li>our hosting provider, with servers in Germany;</li>
              <li>professional advisers and public authorities, where required by law.</li>
            </ul>
            <p>Processors act under written agreements and only on our instructions. We do not sell personal data.</p>
          </section>

          <section>
            <h2>6. Transfers outside the EEA</h2>
            <p>
              Some of the providers above (in particular Google, the jsDelivr CDN, storage.net-fs.com and sketchfab.com) may process data outside the European Economic Area, mainly in the USA. For such transfers we rely on appropriate safeguards, in particular the European Commission’s Standard Contractual Clauses and, where applicable, the EU–US Data Privacy Framework. You can request a copy using the contacts in section 1.
            </p>
          </section>

          <section>
            <h2>7. Your rights</h2>
            <p>
              You have the right to: access your data; correct inaccurate data; have your data erased; restrict or object to processing; receive your data in a portable format; and withdraw consent at any time (this does not affect processing done before withdrawal).
            </p>
            <p>
              To exercise a right, write to <a href="mailto:info@miracon.gr">info@miracon.gr</a>. We reply within one month (extendable by two months for complex requests, with notice).
            </p>
            <p>
              If you think we mishandled your data, you may complain to the <strong>Hellenic Data Protection Authority</strong> — Leof. Kifisias 1-3, 115 23 Athens, +30 210 6475600, <a href="mailto:complaints@dpa.gr">complaints@dpa.gr</a>, <a href="https://www.dpa.gr" target="_blank" rel="noreferrer">www.dpa.gr</a> — or to the authority in your EU country of residence.
            </p>
          </section>

          <section>
            <h2>8. Security</h2>
            <p>
              We use reasonable technical and organisational measures, including HTTPS encryption and access controls. No transmission over the internet is completely secure.
            </p>
          </section>

          <section>
            <h2>9. Children</h2>
            <p>
              The site is intended for adults. We do not knowingly collect data from children under 15. If a child has given us data, contact us and we will delete it.
            </p>
          </section>

          <section>
            <h2>10. Changes</h2>
            <p>
              We may update this policy. The current version, with its date, is always on this page; material changes will be noted on the site.
            </p>
          </section>

          <section>
            <h2>11. Contact</h2>
            <p>
              <strong>MIRACON Single-Member Private Capital Company (Μονοπρόσωπη Ι.Κ.Ε.)</strong><br>
              84 Egnatias Street, 54630 Thessaloniki, Greece<br>
              Email: <a href="mailto:info@miracon.gr">info@miracon.gr</a><br>
              Phone: <a href="tel:+306955340416">+30 695 534 0416</a>
            </p>
          </section>
        </article>
      )}
    </div>
  </main>

  <SiteFooter locale={locale} settings={siteSettings} />

  <script is:inline src="/site.js"></script>
</body>
</html>

