---
import { getLocale, getMessages, localizePath, oppositeLocale, type SiteLocale } from '../lib/i18n';
import { getSiteSettings } from '../lib/site-settings';
import type { SiteSettings } from '../lib/site-settings-shared';
interface Props {
  projectCategory?: string;
  locale?: SiteLocale;
  settings?: SiteSettings;
  goldenVisaActive?: boolean;
}
const { projectCategory, locale = getLocale(Astro.originPathname), settings, goldenVisaActive = false } = Astro.props;
const siteSettings = settings ?? await getSiteSettings();
const m = getMessages(locale);
const projectsHref = localizePath(projectCategory ? `/?filter=${projectCategory}#projects` : '/#projects', locale);
const homeHref = localizePath('/', locale);
const goldenVisaHref = localizePath('/golden-visa', locale);
const aboutHref = localizePath('/#about', locale);
const contactsHref = localizePath(`${Astro.originPathname}#contacts`, locale);
const languageHref = localizePath(`${Astro.originPathname}${Astro.url.search}`, oppositeLocale(locale));
const phoneHref = siteSettings.footerPhone.replace(/[^0-9+]/g, '');
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteSettings.footerAddress[locale])}`;
---

<header class="header notranslate" translate="no">
  <div class="header-container">
    <a href={homeHref} class="logo" aria-label={`${siteSettings.siteName} — ${m['common.home']}`}>
      {siteSettings.siteName === 'MIRACON' && <img src="/img/logo_mark.svg" alt="" class="logo-img">}
      {siteSettings.siteName === 'MIRACON'
        ? <div class="logo-letters" aria-hidden="true">
            {['M', 'I', 'R', 'A', 'C', 'O', 'N'].map((letter) => <img src={`/img/logo_letters/${letter}.svg`} alt="" class="logo-letter">)}
          </div>
        : <span class="site-name-wordmark">{siteSettings.siteName}</span>}
    </a>

    <nav class="nav-menu glass-gradient" aria-label={m['common.mainNavigation']}>
      <a href={projectsHref} class="nav-link">{m['common.projects']}</a>
      <a href={goldenVisaHref} class:list={['nav-link', { 'nav-link-current': goldenVisaActive }]} aria-current={goldenVisaActive ? 'page' : undefined}>{m['common.goldenVisa']}</a>
      <a href={aboutHref} class="nav-link">{m['common.aboutUs']}</a>
      <a href={contactsHref} class="nav-link">{m['common.contacts']}</a>
    </nav>

    <div class="header-actions">
      <a class="lang-selector glass-gradient" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}><span class="lang-current">{m['common.switchLanguageCode']}</span></a>
      <div class="contact-menu">
        <a href={contactsHref} class="contact-btn" aria-haspopup="true">
          <span class="contact-btn-icon"></span>
          <span>{m['common.contact']}</span>
          <span class="contact-btn-arrow" aria-hidden="true">
            <img src="/img/contact_header/Vector 12.svg" alt="">
          </span>
        </a>
        <div class="contact-dropdown" aria-label={m['common.quickContacts']}>
          {phoneHref && <a href={`tel:${phoneHref}`} class="contact-dropdown-link contact-dropdown-link--phone" aria-label={`${m['form.phone']}: ${siteSettings.footerPhone}`}>
            <span class="contact-dropdown-text">{siteSettings.footerPhone}</span>
            <span class="contact-dropdown-circle" aria-hidden="true"><img src="/img/contact_header/Vector (1).svg" alt=""></span>
          </a>}
          {siteSettings.footerEmail && <a href={`mailto:${siteSettings.footerEmail}`} class="contact-dropdown-link contact-dropdown-link--mail" aria-label={`${m['form.email']}: ${siteSettings.footerEmail}`}>
            <span class="contact-dropdown-text">{siteSettings.footerEmail}</span>
            <span class="contact-dropdown-circle" aria-hidden="true"><img src="/img/contact_header/Group 37313 (1).svg" alt=""></span>
          </a>}
          {siteSettings.footerAddress[locale] && <a href={mapHref} class="contact-dropdown-link contact-dropdown-link--geo" target="_blank" rel="noopener noreferrer" aria-label={`${m['common.openAddress']}: ${siteSettings.footerAddress[locale]}`}>
            <span class="contact-dropdown-text">{siteSettings.footerAddress[locale]}</span>
            <span class="contact-dropdown-circle" aria-hidden="true"><img src="/img/contact_header/Vector (2).svg" alt=""></span>
          </a>}
        </div>
      </div>
    </div>

    <a class="mobile-lang-selector" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}>
      <span>{m['common.switchLanguageCode']}</span>
    </a>
    <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label={m['common.openMenu']} aria-controls="mobileNav" aria-expanded="false">
      <span aria-hidden="true"></span>
    </button>
    <nav class="mobile-nav" id="mobileNav" aria-label={m['common.mobileNavigation']}>
      <a href={projectsHref} class="mobile-nav-link">{m['common.projects']}</a>
      <a href={goldenVisaHref} class="mobile-nav-link" aria-current={goldenVisaActive ? 'page' : undefined}>{m['common.goldenVisa']}</a>
      <a href={aboutHref} class="mobile-nav-link">{m['common.aboutUs']}</a>
      <button class="mobile-nav-contact" type="button" aria-expanded="false" aria-controls="mobileContactDetails">
        <span>{m['common.contacts']}</span><span aria-hidden="true">+</span>
      </button>
      <div class="mobile-nav-contacts" id="mobileContactDetails">
        {phoneHref && <a href={`tel:${phoneHref}`}>{siteSettings.footerPhone}</a>}
        {siteSettings.footerEmail && <a href={`mailto:${siteSettings.footerEmail}`}>{siteSettings.footerEmail}</a>}
        {siteSettings.footerAddress[locale] && <a href={mapHref} target="_blank" rel="noopener noreferrer">{siteSettings.footerAddress[locale]}</a>}
      </div>
    </nav>
  </div>
</header>
