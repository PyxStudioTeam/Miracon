---
import { getContactDescriptionLines, getMessages, type SiteLocale } from '../lib/i18n';
import { defaultSiteSettings, getSiteSettings, resolvePrivacyPdfUrl } from '../lib/site-settings';
import type { SiteSettings } from '../lib/site-settings-shared';

interface Props {
  locale?: SiteLocale;
  settings?: SiteSettings;
}

const { locale = 'en', settings } = Astro.props;
const siteSettings = settings ?? await getSiteSettings();
const m = getMessages(locale);
const contactCopy = siteSettings.contactCopy[locale];
const privacyHref = resolvePrivacyPdfUrl(siteSettings.footerPrivacyPdfUrl, locale);
---

<section id="contacts" class="contacts-section">
  <div class="container">
    <div class="form-container">
      <h2 class="section-title">{contactCopy.title}</h2>
      <p class="section-subtitle form-description-copy">
        {contactCopy.description === defaultSiteSettings.contactCopy[locale].description
          ? getContactDescriptionLines(locale).map((line) => <span>{line}</span>)
          : <span>{contactCopy.description}</span>}
      </p>
      <form class="consultation-form" data-consultation-form novalidate>
        <div class="form-row">
          <label class="form-group"><span>{m['form.name']} *</span><input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required></label>
          <label class="form-group"><span>{m['form.phone']} *</span><input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40" required></label>
          <label class="form-group"><span>{m['form.email']} *</span><input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254" required></label>
        </div>
        <label class="form-group form-message">
          <span>{m['form.message']} *</span>
          <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000" required></textarea>
        </label>
        <label class="form-consent">
          <input type="checkbox" name="consent" class="form-consent-input" required disabled={!privacyHref}>
          <span class="form-consent-box" aria-hidden="true"></span>
          <span class="form-consent-text">{privacyHref
            ? <>{m['form.consentBefore']} <a href={privacyHref} target="_blank" rel="noopener noreferrer">{m['common.privacy']}</a> {m['form.consentAfter']}</>
            : m['form.policyUnavailable']}</span>
        </label>
        <button type="submit" class="btn-submit" disabled>
          <span>{m['form.submit']}</span><span class="btn-submit-arrow"></span>
        </button>
        <input class="form-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <p class="form-status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>
