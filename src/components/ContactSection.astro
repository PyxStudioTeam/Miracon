---
import { getContactDescriptionLines, getMessages, type SiteLocale } from '../lib/i18n';

interface Props {
  locale?: SiteLocale;
}

const { locale = 'en' } = Astro.props;
const m = getMessages(locale);
const descriptionLines = getContactDescriptionLines(locale);
---

<section id="contacts" class="contacts-section">
  <div class="container">
    <div class="form-container">
      <h2 class="section-title">{m['form.title']}</h2>
      <p class="section-subtitle form-description-copy">
        {descriptionLines.map((line) => <span>{line}</span>)}
      </p>
      <form class="consultation-form" data-consultation-form data-web3forms-key="bcf7cde0-e5e8-4908-8b89-02ebe78bcd0d" novalidate>
        <div class="form-row">
          <label class="form-group"><span>{m['form.name']}</span><input type="text" name="name" class="form-input" placeholder={m['form.name']} maxlength="120" required></label>
          <label class="form-group"><span>{m['form.phone']}</span><input type="tel" name="phone" class="form-input" placeholder={m['form.phone']} maxlength="40"></label>
          <label class="form-group"><span>{m['form.email']}</span><input type="email" name="email" class="form-input" placeholder={m['form.email']} maxlength="254"></label>
        </div>
        <label class="form-group form-message">
          <span>{m['form.message']}</span>
          <textarea name="message" class="form-input form-textarea" placeholder={m['form.message']} maxlength="3000"></textarea>
        </label>
        <label class="form-consent">
          <input type="checkbox" name="consent" class="form-consent-input" required>
          <span class="form-consent-box" aria-hidden="true"></span>
          <span class="form-consent-text">{m['form.consentBefore']} <a href="#">{m['common.privacy']}</a> {m['form.consentAfter']}</span>
        </label>
        <div class="form-captcha"><div class="h-captcha" data-captcha="true" data-theme="light"></div></div>
        <button type="submit" class="btn-submit" disabled>
          <span>{m['form.submit']}</span><span class="btn-submit-arrow"></span>
        </button>
        <input class="form-honeypot" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true">
        <p class="form-status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>
