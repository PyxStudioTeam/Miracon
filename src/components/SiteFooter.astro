---
import { getSiteSettings, resolvePrivacyPdfUrl } from '../lib/site-settings';
import FooterSocialLinks from './FooterSocialLinks.astro';
import type { SiteSettings } from '../lib/site-settings-shared';
import { getLocale, getMessages, localizePath, oppositeLocale, type SiteLocale } from '../lib/i18n';

interface Props {
  locale?: SiteLocale;
  settings?: SiteSettings;
}

const { locale = getLocale(Astro.originPathname), settings } = Astro.props;
const siteSettings = settings ?? await getSiteSettings();
const m = getMessages(locale);
const languageHref = localizePath(`${Astro.originPathname}${Astro.url.search}`, oppositeLocale(locale));
const phoneHref = siteSettings.footerPhone.replace(/[^0-9+]/g, '');
const privacyPdfUrl = resolvePrivacyPdfUrl(siteSettings.footerPrivacyPdfUrl, locale);
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <a href={localizePath('/', locale)} class:list={['logo', { 'logo--custom': siteSettings.logoUrl }]} aria-label={`${siteSettings.siteName} — ${m['common.home']}`}>
        {siteSettings.logoUrl
          ? <img src={siteSettings.logoUrl} alt="" class="custom-logo-image">
          : siteSettings.siteName === 'MIRACON'
            ? <>
                <img src="/img/logo_mark.svg" alt="" class="logo-img">
                <div class="logo-letters" aria-hidden="true">
                  {['M', 'I', 'R', 'A', 'C', 'O', 'N'].map((letter) => <img src={`/img/logo_letters/${letter}.svg`} alt="" class="logo-letter">)}
                </div>
              </>
            : <span class="site-name-wordmark">{siteSettings.siteName}</span>}
      </a>
      <FooterSocialLinks settings={siteSettings} locale={locale} />
      <div class="footer-contact-details">
        {phoneHref && <a href={`tel:${phoneHref}`}>{siteSettings.footerPhone}</a>}
        {siteSettings.footerEmail && <a href={`mailto:${siteSettings.footerEmail}`}>{siteSettings.footerEmail}</a>}
        {siteSettings.footerAddress[locale] && <span class="footer-address">{siteSettings.footerAddress[locale]}</span>}
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-links">
        <a href={siteSettings.footerTermsPdfUrl || '#'} target={siteSettings.footerTermsPdfUrl ? '_blank' : undefined} rel={siteSettings.footerTermsPdfUrl ? 'noreferrer' : undefined} hidden={!siteSettings.footerTermsVisible}>{m['common.terms']}</a>
        {privacyPdfUrl && <a href={privacyPdfUrl} target="_blank" rel="noopener noreferrer">{m['common.privacy']}</a>}
        <a href={siteSettings.footerCookiePdfUrl || '#'} target={siteSettings.footerCookiePdfUrl ? '_blank' : undefined} rel={siteSettings.footerCookiePdfUrl ? 'noreferrer' : undefined} hidden={!siteSettings.footerCookieVisible}>{m['common.cookies']}</a>
      </div>
      <a class="lang-dropdown-btn" href={languageHref} hreflang={oppositeLocale(locale)} aria-label={m['common.switchLanguage']}><span>{m['common.switchLanguage']}</span><span class="lang-refresh" aria-hidden="true"><img src="/img/Vector.svg" alt=""></span></a>
    </div>
    <p class="footer-copyright">{siteSettings.companyName === 'MIRACON Constructions' ? m['common.copyright'] : m['common.copyright'].replace('Miracon Constructions', siteSettings.companyName)}</p>
  </div>
</footer>
