{
  "name": "miracon-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test:vitest && npm run test:node",
    "test:vitest": "npm run admin:test && npm run auth:test && npm run server:test && npm run media:test",
    "test:node": "npm run postgres:test:contract && npm run migration:test && npm run release:test",
    "test:db": "npm run postgres:test:db && npm run auth:test:db && npm run api:test:db && npm run api:test:http:db && npm run server:test:db && npm run media:test:db && npm run migration:import:test:db && npm run standalone:test:db && npm run browser:test:db",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "admin:test": "vitest run src/admin/admin-api.test.ts",
    "auth:test": "vitest run auth-tests/authorization.test.ts auth-tests/crypto-password.test.ts auth-tests/login-transaction.test.mjs auth-tests/provision-admin.test.ts auth-tests/request-cookie.test.ts auth-tests/users-management.test.ts",
    "auth:test:db": "node scripts/require-database-test-config.mjs && vitest run --maxWorkers=1 auth-tests/auth-database.test.ts",
    "browser:install": "playwright install chromium",
    "browser:test:db": "node scripts/require-database-test-config.mjs && node --test --test-concurrency=1 browser-tests/public-localization-layout.test.mjs",
    "api:test:db": "node scripts/require-database-test-config.mjs && vitest run --maxWorkers=1 api-tests/api.test.ts api-tests/media-upload.test.ts",
    "api:test:http:db": "node scripts/require-database-test-config.mjs && node --test api-tests/http-transport.test.mjs",
    "admin:provision": "node scripts/provision-admin.mjs",
    "postgres:migrate": "node scripts/postgres-migrate.mjs",
    "postgres:test:contract": "node --test postgres/tests/schema-contract.test.mjs postgres/tests/migration-ledger.test.mjs postgres/tests/database-test-guard.test.mjs",
    "postgres:test:db": "node scripts/require-database-test-config.mjs && node --test --test-concurrency=1 postgres/tests/database.test.mjs postgres/tests/database-constraints.test.mjs postgres/tests/database-homepage.test.mjs postgres/tests/migration-runner-database.test.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:test": "node --test release-tests/*.test.mjs",
    "release:verify": "npm run check && npm run build && npm test",
    "server:test": "vitest run server-tests/runtime-contracts.test.ts server-tests/revision-contracts.test.ts server-tests/project-revision-adapter.test.ts server-tests/project-revision-http.test.ts server-tests/homepage-site-settings-revisions.test.ts server-tests/revisions.test.ts",
    "server:test:db": "node scripts/require-database-test-config.mjs && vitest run --maxWorkers=1 server-tests/postgres-repositories.test.ts server-tests/revisions-postgres.test.ts",
    "standalone:test:db": "node scripts/require-database-test-config.mjs && node --test server-tests/standalone-build.test.mjs",
    "media:test": "vitest run --maxWorkers=1 media-tests/local-media-cleanup-unit.test.ts media-tests/media-hardening.test.ts media-tests/media-route-cache.test.ts",
    "media:test:db": "node scripts/require-database-test-config.mjs && vitest run --maxWorkers=1 media-tests/local-media.test.ts media-tests/local-media-cleanup.test.ts media-tests/local-media-cleanup-apply.test.ts",
    "media:cleanup": "node scripts/local-media-cleanup.mjs",
    "migration:export": "node scripts/supabase-export.mjs",
    "migration:media": "node scripts/supabase-media-transfer.mjs",
    "migration:media:verify": "node scripts/verify-media-state.mjs",
    "migration:import": "node scripts/supabase-import.mjs",
    "migration:validate": "node scripts/migration/validate-transfer.mjs",
    "migration:test": "node --test migration-tests/*.test.mjs migration-export-tests/*.test.mjs migration-media-tests/*.test.mjs migration-import-tests/preparation.test.mjs migration-import-tests/parity-report.test.mjs",
    "migration:import:test:db": "node scripts/require-database-test-config.mjs && node --test --test-concurrency=1 migration-import-tests/postgres-import.database.test.mjs",
    "worker:start": "npm --prefix worker start",
    "worker:test": "npm --prefix worker test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^11.1.1",
    "@astrojs/react": "^6.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "argon2": "^0.45.1",
    "astro": "^7.0.7",
    "lucide-react": "^1.24.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "playwright": "^1.61.0",
    "vitest": "^4.1.10"
  }
}
