DATABASE_URL=
MEDIA_ROOT=
# Canonical public HTTPS origin. Local HTTP loopback is development/test only.
PUBLIC_SITE_URL=https://miracon.gr
# Server-only HMAC key for contact challenge, client, and duplicate digests.
# Required in production; use an independently generated value of at least 32 characters.
CONTACT_DIGEST_SECRET=
# Server-only SMTP delivery by a separately scheduled mail worker; disabled by default.
# Use 465 for implicit TLS or 587 for required STARTTLS. Never add PUBLIC_ prefixes.
CONTACT_SMTP_ENABLED=false
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_FROM=
CONTACT_SMTP_TO=
# Optional acknowledgement for accepted contact submissions with email; off by default.
CONTACT_AUTOREPLY_ENABLED=false
# Legacy migration/rollback inputs below; not used by the standalone runtime.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_MEDIA_WORKER_ENABLED=false
# Used only by offline legacy migration/rollback tooling.
# Never expose this value to the browser or add a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
